       IDENTIFICATION DIVISION.
       PROGRAM-ID. TLS-CERT-AUDIT-TEST.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  AUDIT-LOG-RECORD            PIC X(512).
       01  WS-CERT-SERIAL-NUM          PIC X(40).
       01  WS-ISSUER-COMMON-NAME       PIC X(256).
       01  WS-SUBJECT-COMMON-NAME      PIC X(300).
       01  WS-EXPECTED-HOSTNAME        PIC X(255).
       01  WS-HOSTNAME-SENTINEL        PIC X(255).
       01  WS-VALIDATION-RESULT        PIC X(1).
       01  WS-VALIDATION-MSG           PIC X(128).
       01  WS-AUDIT-TIMESTAMP          PIC X(26).
       01  WS-AUDIT-PTR                PIC 9(4)  VALUE 1.
       01  WS-AUDIT-RECORD-LENGTH      PIC 9(4)  VALUE 512.
       01  WS-AUDIT-DATA-LIMIT         PIC 9(4)  VALUE 501.
       01  WS-AUDIT-FIELD              PIC X(512).
       01  WS-AUDIT-TRUNCATED          PIC X(1)  VALUE 'N'.
           88  WS-AUDIT-WAS-TRUNCATED  VALUE 'Y'.
           88  WS-AUDIT-NOT-TRUNCATED  VALUE 'N'.
       01  WS-TEST-FAILURES            PIC 9(2)  VALUE 0.

       PROCEDURE DIVISION.
       0000-RUN-TESTS.
           MOVE '20260514190000000000000000'
               TO WS-AUDIT-TIMESTAMP
           MOVE 'api.internal.example' TO WS-HOSTNAME-SENTINEL
           MOVE WS-HOSTNAME-SENTINEL TO WS-EXPECTED-HOSTNAME
           MOVE '0123456789ABCDEF' TO WS-CERT-SERIAL-NUM
           MOVE 'V' TO WS-VALIDATION-RESULT
           MOVE 'VALIDATION SUCCESSFUL' TO WS-VALIDATION-MSG

           MOVE 'ISSUER CN' TO WS-ISSUER-COMMON-NAME
           MOVE 'SUBJECT CN' TO WS-SUBJECT-COMMON-NAME
           PERFORM 8000-WRITE-AUDIT-ENTRY
           IF WS-AUDIT-WAS-TRUNCATED
               DISPLAY 'FAIL: SHORT AUDIT ENTRY SHOULD FIT'
               ADD 1 TO WS-TEST-FAILURES
           END-IF
           IF AUDIT-LOG-RECORD(502:11) = '[TRUNCATED]'
               DISPLAY 'FAIL: SHORT AUDIT ENTRY HAS TRUNCATION MARKER'
               ADD 1 TO WS-TEST-FAILURES
           END-IF

           MOVE ALL 'I' TO WS-ISSUER-COMMON-NAME
           MOVE ALL 'S' TO WS-SUBJECT-COMMON-NAME
           PERFORM 8000-WRITE-AUDIT-ENTRY
           IF WS-AUDIT-NOT-TRUNCATED
               DISPLAY 'FAIL: LONG SUBJECT DN SHOULD TRUNCATE'
               ADD 1 TO WS-TEST-FAILURES
           END-IF
           IF AUDIT-LOG-RECORD(502:11) NOT = '[TRUNCATED]'
               DISPLAY 'FAIL: LONG SUBJECT DN MISSING MARKER'
               ADD 1 TO WS-TEST-FAILURES
           END-IF
           IF WS-EXPECTED-HOSTNAME NOT = WS-HOSTNAME-SENTINEL
               DISPLAY 'FAIL: HOSTNAME FIELD WAS CORRUPTED'
               ADD 1 TO WS-TEST-FAILURES
           END-IF

           IF WS-TEST-FAILURES > 0
               MOVE 1 TO RETURN-CODE
           END-IF
           STOP RUN.

       8000-WRITE-AUDIT-ENTRY.
           MOVE SPACES TO AUDIT-LOG-RECORD
           MOVE 1 TO WS-AUDIT-PTR
           SET WS-AUDIT-NOT-TRUNCATED TO TRUE
           MOVE WS-AUDIT-TIMESTAMP TO WS-AUDIT-FIELD
           PERFORM 8100-APPEND-AUDIT-FIELD
           MOVE '|' TO WS-AUDIT-FIELD
           PERFORM 8100-APPEND-AUDIT-FIELD
           MOVE WS-CERT-SERIAL-NUM TO WS-AUDIT-FIELD
           PERFORM 8100-APPEND-AUDIT-FIELD
           MOVE '|' TO WS-AUDIT-FIELD
           PERFORM 8100-APPEND-AUDIT-FIELD
           MOVE WS-ISSUER-COMMON-NAME TO WS-AUDIT-FIELD
           PERFORM 8100-APPEND-AUDIT-FIELD
           MOVE '|' TO WS-AUDIT-FIELD
           PERFORM 8100-APPEND-AUDIT-FIELD
           MOVE WS-SUBJECT-COMMON-NAME TO WS-AUDIT-FIELD
           PERFORM 8100-APPEND-AUDIT-FIELD
           MOVE '|' TO WS-AUDIT-FIELD
           PERFORM 8100-APPEND-AUDIT-FIELD
           MOVE WS-VALIDATION-RESULT TO WS-AUDIT-FIELD
           PERFORM 8100-APPEND-AUDIT-FIELD
           MOVE '|' TO WS-AUDIT-FIELD
           PERFORM 8100-APPEND-AUDIT-FIELD
           MOVE WS-VALIDATION-MSG TO WS-AUDIT-FIELD
           PERFORM 8100-APPEND-AUDIT-FIELD
           .

       8100-APPEND-AUDIT-FIELD.
           IF WS-AUDIT-PTR > WS-AUDIT-DATA-LIMIT
               PERFORM 8200-MARK-AUDIT-TRUNCATED
           ELSE
               STRING FUNCTION TRIM(WS-AUDIT-FIELD TRAILING)
                   DELIMITED SIZE
                   INTO AUDIT-LOG-RECORD
                   WITH POINTER WS-AUDIT-PTR
                   ON OVERFLOW
                       PERFORM 8200-MARK-AUDIT-TRUNCATED
               END-STRING
           END-IF
           MOVE SPACES TO WS-AUDIT-FIELD
           .

       8200-MARK-AUDIT-TRUNCATED.
           SET WS-AUDIT-WAS-TRUNCATED TO TRUE
           MOVE '[TRUNCATED]' TO AUDIT-LOG-RECORD(502:11)
           COMPUTE WS-AUDIT-PTR = WS-AUDIT-RECORD-LENGTH + 1
           .
