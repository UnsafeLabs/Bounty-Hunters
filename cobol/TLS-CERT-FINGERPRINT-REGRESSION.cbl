       IDENTIFICATION DIVISION.
       PROGRAM-ID. TLS-CERT-FINGERPRINT-REGRESSION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-CERT-FINGERPRINT         PIC X(64).
       01  CS-FINGERPRINT              PIC X(64).
       01  WS-SIG-VERIFY-BUFFER        PIC X(64) USAGE DISPLAY.
       01  WS-FINGERPRINT-INDEX        PIC 9(2) COMP.
       01  WS-FINGERPRINT-MATCH        PIC X(1).
           88  WS-FINGERPRINTS-MATCH   VALUE 'Y'.
           88  WS-FINGERPRINTS-DIFFER  VALUE 'N'.
       01  WS-TEST-FAILURES            PIC 9(2) VALUE 0.
       PROCEDURE DIVISION.
       0000-RUN-TESTS.
           MOVE 'AABBCCDDEEFF00112233445566778899AABBCCDDEEFF00112233445566778899'
               TO WS-CERT-FINGERPRINT
           MOVE 'AABBCCDDEEFF00112233445566778899AABBCCDDEEFF00112233445566778899'
               TO CS-FINGERPRINT
           PERFORM 4000-COMPARE-FINGERPRINT
           IF NOT WS-FINGERPRINTS-MATCH
               DISPLAY 'FAIL: A-F FINGERPRINT SHOULD MATCH'
               ADD 1 TO WS-TEST-FAILURES
           END-IF

           MOVE '0011223344556677889900112233445566778899001122334455667788990011'
               TO WS-CERT-FINGERPRINT
           MOVE '0011223344556677889900112233445566778899001122334455667788990011'
               TO CS-FINGERPRINT
           PERFORM 4000-COMPARE-FINGERPRINT
           IF NOT WS-FINGERPRINTS-MATCH
               DISPLAY 'FAIL: DIGIT FINGERPRINT SHOULD MATCH'
               ADD 1 TO WS-TEST-FAILURES
           END-IF

           MOVE 'AABBCCDDEEFF00112233445566778899AABBCCDDEEFF00112233445566778899'
               TO WS-CERT-FINGERPRINT
           MOVE 'AABBCCDDEEFF00112233445566778899AABBCCDDEEFF00112233445566778898'
               TO CS-FINGERPRINT
           PERFORM 4000-COMPARE-FINGERPRINT
           IF NOT WS-FINGERPRINTS-DIFFER
               DISPLAY 'FAIL: CHANGED FINGERPRINT SHOULD DIFFER'
               ADD 1 TO WS-TEST-FAILURES
           END-IF

           IF WS-TEST-FAILURES = 0
               DISPLAY 'PASS: FINGERPRINT REGRESSION CASES'
           ELSE
               DISPLAY 'FAILURES: ' WS-TEST-FAILURES
           END-IF
           STOP RUN.

       4000-COMPARE-FINGERPRINT.
           MOVE WS-CERT-FINGERPRINT TO WS-SIG-VERIFY-BUFFER
           SET WS-FINGERPRINTS-MATCH TO TRUE
           PERFORM VARYING WS-FINGERPRINT-INDEX FROM 1 BY 1
               UNTIL WS-FINGERPRINT-INDEX > 64
               IF FUNCTION ORD(
                   WS-SIG-VERIFY-BUFFER(WS-FINGERPRINT-INDEX:1))
                   NOT = FUNCTION ORD(
                   CS-FINGERPRINT(WS-FINGERPRINT-INDEX:1))
                   SET WS-FINGERPRINTS-DIFFER TO TRUE
               END-IF
           END-PERFORM
           .
