       IDENTIFICATION DIVISION.
       PROGRAM-ID. TLS-CERT-FINGERPRINT-TEST.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-CERT-FINGERPRINT         PIC X(64).
       01  CS-FINGERPRINT              PIC X(64).
       01  WS-SIG-VERIFY-BUFFER        PIC X(64).
       01  WS-FINGERPRINT-INDEX        PIC 9(2).
       01  WS-FINGERPRINT-MATCH        PIC X(1).
       01  WS-TEST-FAILURES            PIC 9(2) VALUE 0.
       PROCEDURE DIVISION.
       0000-RUN-TESTS.
           PERFORM 1000-LOAD-A-F-FINGERPRINT
           MOVE WS-CERT-FINGERPRINT TO CS-FINGERPRINT
           PERFORM 4000-COMPARE-FINGERPRINTS
           IF WS-FINGERPRINT-MATCH NOT = 'Y'
               DISPLAY 'FAIL: A-F FINGERPRINT SHOULD MATCH'
               ADD 1 TO WS-TEST-FAILURES
           END-IF

           PERFORM 2000-LOAD-DIGIT-FINGERPRINT
           MOVE WS-CERT-FINGERPRINT TO CS-FINGERPRINT
           PERFORM 4000-COMPARE-FINGERPRINTS
           IF WS-FINGERPRINT-MATCH NOT = 'Y'
               DISPLAY 'FAIL: DIGIT FINGERPRINT SHOULD MATCH'
               ADD 1 TO WS-TEST-FAILURES
           END-IF

           PERFORM 1000-LOAD-A-F-FINGERPRINT
           STRING 'AABBCCDDEEFF00112233445566778899'
               'AABBCCDDEEFF00112233445566778898'
               INTO CS-FINGERPRINT
           END-STRING
           PERFORM 4000-COMPARE-FINGERPRINTS
           IF WS-FINGERPRINT-MATCH NOT = 'N'
               DISPLAY 'FAIL: CHANGED FINGERPRINT SHOULD NOT MATCH'
               ADD 1 TO WS-TEST-FAILURES
           END-IF

           IF WS-TEST-FAILURES > 0
               MOVE 1 TO RETURN-CODE
           END-IF
           STOP RUN.

       1000-LOAD-A-F-FINGERPRINT.
           STRING 'AABBCCDDEEFF00112233445566778899'
               'AABBCCDDEEFF00112233445566778899'
               INTO WS-CERT-FINGERPRINT
           END-STRING
           .

       2000-LOAD-DIGIT-FINGERPRINT.
           STRING '00112233445566778899001122334455'
               '66778899001122334455667788990011'
               INTO WS-CERT-FINGERPRINT
           END-STRING
           .

       4000-COMPARE-FINGERPRINTS.
           MOVE WS-CERT-FINGERPRINT TO WS-SIG-VERIFY-BUFFER
           MOVE 'Y' TO WS-FINGERPRINT-MATCH
           PERFORM VARYING WS-FINGERPRINT-INDEX FROM 1 BY 1
               UNTIL WS-FINGERPRINT-INDEX > 64
               IF FUNCTION ORD(
                   WS-SIG-VERIFY-BUFFER(WS-FINGERPRINT-INDEX:1))
                   NOT = FUNCTION ORD(
                   CS-FINGERPRINT(WS-FINGERPRINT-INDEX:1))
                   MOVE 'N' TO WS-FINGERPRINT-MATCH
               END-IF
           END-PERFORM
           .
