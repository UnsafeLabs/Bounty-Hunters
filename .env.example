# BountyHunters Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bountyhunters
DATABASE_USER=admin
DATABASE_PASSWORD=your_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=true

# Optional: API Keys
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
