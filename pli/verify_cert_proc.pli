/* VERIFY_CERT_PROC - PL/I TLS certificate parser hardening for issue 566.
 *
 * The previous failure mode relied on condition handlers for AREA and STRINGSIZE.
 * Those handlers hid the actual corruption: AREA retry cleared still-linked
 * CERT_NODE storage, and STRINGSIZE RESUME kept comparing truncated OIDs.
 */

VERIFY_CERT_PROC: PROCEDURE OPTIONS(MAIN);

   DCL CERT_AREA AREA(8192);
   DCL CERT_AREA_LIMIT BIN FIXED(31) INIT(3584);
   DCL MAX_CERT_NODES BIN FIXED(31) INIT(128);
   DCL MAX_VISITED_NODES BIN FIXED(31) INIT(128);
   DCL VERIFY_STATUS BIN FIXED(31) INIT(0);

   DCL 1 CERT_NODE BASED,
        2 SUBJECT_DN CHAR(300) VARYING,
        2 ISSUER_DN CHAR(300) VARYING,
        2 SIG_OID CHAR(256) VARYING,
        2 SERIAL BIN FIXED(31),
        2 NEXT_NODE POINTER;

   DCL 1 SAVED_CERTS(128),
        2 S_SUBJECT_DN CHAR(300) VARYING,
        2 S_ISSUER_DN CHAR(300) VARYING,
        2 S_SIG_OID CHAR(256) VARYING,
        2 S_SERIAL BIN FIXED(31);

   DCL CERT_PTR POINTER INIT(NULL());
   DCL CHAIN_HEAD POINTER INIT(NULL());
   DCL CHAIN_TAIL POINTER INIT(NULL());
   DCL NODE_COUNT BIN FIXED(31) INIT(0);
   DCL VISITED_PTRS(128) POINTER INIT((128)NULL());
   DCL VISITED_COUNT BIN FIXED(31) INIT(0);

   DCL OID_STRING CHAR(256) VARYING INIT('');
   DCL EXPECTED_SIG_OID CHAR(256) VARYING INIT('1.2.840.113549.1.1.11');

   DCL DER_BUF CHAR(8192);
   DCL DER_LEN BIN FIXED(31);
   DCL PARSE_TREE_PTR POINTER INIT(NULL());

   /* Static external parser keeps parse-tree storage lifetime stable.
    * No FETCH/RELEASE is used around TLS_ASN1_PARSE.
    */
   DCL TLS_ASN1_PARSE ENTRY(CHAR(*), BIN FIXED(31), POINTER) EXTERNAL;

   EXPAND_CERT_AREA: PROCEDURE;
      DCL J BIN FIXED(31);

      CERT_AREA = EMPTY;
      CHAIN_HEAD = NULL();
      CHAIN_TAIL = NULL();

      DO J = 1 TO NODE_COUNT;
         ALLOCATE CERT_NODE IN(CERT_AREA) SET(CERT_PTR);
         CALL ASSERT_CERT_PTR_IN_AREA(CERT_PTR, 'expand');

         CERT_PTR->SUBJECT_DN = S_SUBJECT_DN(J);
         CERT_PTR->ISSUER_DN = S_ISSUER_DN(J);
         CERT_PTR->SIG_OID = S_SIG_OID(J);
         CERT_PTR->SERIAL = S_SERIAL(J);
         CERT_PTR->NEXT_NODE = NULL();

         CALL APPEND_CERT_PTR(CERT_PTR);
      END;
   END EXPAND_CERT_AREA;

   ENSURE_CERT_CAPACITY: PROCEDURE;
      IF ALLOCATION(CERT_AREA) > CERT_AREA_LIMIT THEN
         CALL EXPAND_CERT_AREA();
   END ENSURE_CERT_CAPACITY;

   ASSERT_CERT_PTR_IN_AREA: PROCEDURE(PTR, WHERE);
      DCL PTR POINTER;
      DCL WHERE CHAR(*) VARYING;

      IF PTR = NULL() THEN DO;
         VERIFY_STATUS = -1;
         PUT SKIP LIST('ERROR: null CERT_PTR at ' || WHERE);
         RETURN;
      END;

      IF ADDR(CERT_AREA) > PTR |
         PTR > ADDR(CERT_AREA) + 8192 THEN DO;
         VERIFY_STATUS = -2;
         PUT SKIP LIST('ERROR: CERT_PTR outside active CERT_AREA at ' || WHERE);
      END;
   END ASSERT_CERT_PTR_IN_AREA;

   SAVE_CERT_PTR: PROCEDURE(PTR);
      DCL PTR POINTER;
      DCL SLOT BIN FIXED(31);

      SLOT = NODE_COUNT + 1;
      IF SLOT > MAX_CERT_NODES THEN DO;
         VERIFY_STATUS = -3;
         RETURN;
      END;

      S_SUBJECT_DN(SLOT) = PTR->SUBJECT_DN;
      S_ISSUER_DN(SLOT) = PTR->ISSUER_DN;
      S_SIG_OID(SLOT) = PTR->SIG_OID;
      S_SERIAL(SLOT) = PTR->SERIAL;
   END SAVE_CERT_PTR;

   APPEND_CERT_PTR: PROCEDURE(PTR);
      DCL PTR POINTER;

      CALL ASSERT_CERT_PTR_IN_AREA(PTR, 'append');
      IF VERIFY_STATUS ^= 0 THEN RETURN;

      IF CHAIN_HEAD = NULL() THEN
         CHAIN_HEAD = PTR;
      ELSE
         CHAIN_TAIL->NEXT_NODE = PTR;

      CHAIN_TAIL = PTR;
   END APPEND_CERT_PTR;

   BUILD_OID: PROCEDURE(ARCS, ARC_COUNT) RETURNS(CHAR(256) VARYING);
      DCL ARCS(*) BIN FIXED(31);
      DCL ARC_COUNT BIN FIXED(31);
      DCL I BIN FIXED(31);
      DCL ARC_STR CHAR(16) VARYING;
      DCL RESULT CHAR(256) VARYING INIT('');

      DO I = 1 TO ARC_COUNT;
         ARC_STR = TRIM(CHAR(ARCS(I)));
         IF I = 1 THEN DO;
            IF LENGTH(ARC_STR) > MAXLENGTH(RESULT) THEN
               RETURN('INVALID');
            RESULT = ARC_STR;
         END;
         ELSE DO;
            IF LENGTH(RESULT) + LENGTH(ARC_STR) + 1 > MAXLENGTH(RESULT) THEN
               RETURN('INVALID');
            RESULT = RESULT || '.' || ARC_STR;
         END;
      END;

      RETURN(RESULT);
   END BUILD_OID;

   TRAVERSE_PARSE_TREE: PROCEDURE(ROOT) RETURNS(BIT(1));
      DCL ROOT POINTER;
      DCL CUR POINTER;
      DCL I BIN FIXED(31);

      CUR = ROOT;
      VISITED_COUNT = 0;
      DO WHILE(CUR ^= NULL());
         DO I = 1 TO VISITED_COUNT;
            IF VISITED_PTRS(I) = CUR THEN
               RETURN('0'B);
         END;

         VISITED_COUNT = VISITED_COUNT + 1;
         IF VISITED_COUNT > MAX_VISITED_NODES THEN
            RETURN('0'B);
         VISITED_PTRS(VISITED_COUNT) = CUR;

         CUR = CUR->NEXT_NODE;
      END;

      RETURN('1'B);
   END TRAVERSE_PARSE_TREE;

   ADD_CERT_NODE: PROCEDURE(SUBJECT, ISSUER, SIGOID, SERIAL);
      DCL SUBJECT CHAR(*) VARYING;
      DCL ISSUER CHAR(*) VARYING;
      DCL SIGOID CHAR(*) VARYING;
      DCL SERIAL BIN FIXED(31);

      CALL ENSURE_CERT_CAPACITY();
      IF VERIFY_STATUS ^= 0 THEN RETURN;

      ALLOCATE CERT_NODE IN(CERT_AREA) SET(CERT_PTR);
      CALL ASSERT_CERT_PTR_IN_AREA(CERT_PTR, 'allocate');
      IF VERIFY_STATUS ^= 0 THEN RETURN;

      CERT_PTR->SUBJECT_DN = SUBJECT;
      CERT_PTR->ISSUER_DN = ISSUER;
      CERT_PTR->SIG_OID = SIGOID;
      CERT_PTR->SERIAL = SERIAL;
      CERT_PTR->NEXT_NODE = NULL();

      CALL SAVE_CERT_PTR(CERT_PTR);
      CALL APPEND_CERT_PTR(CERT_PTR);
      NODE_COUNT = NODE_COUNT + 1;
   END ADD_CERT_NODE;

   VERIFY_CERTIFICATE_DER: PROCEDURE;
      DCL SIG_ARCS(7) BIN FIXED(31) INIT(1,2,840,113549,1,1,11);

      DER_LEN = LENGTH(DER_BUF);
      CALL TLS_ASN1_PARSE(DER_BUF, DER_LEN, PARSE_TREE_PTR);

      IF ^TRAVERSE_PARSE_TREE(PARSE_TREE_PTR) THEN DO;
         VERIFY_STATUS = -4;
         PUT SKIP LIST('ERROR: parse tree cycle detected');
         RETURN;
      END;

      OID_STRING = BUILD_OID(SIG_ARCS, 7);
      IF OID_STRING = 'INVALID' THEN DO;
         VERIFY_STATUS = -5;
         PUT SKIP LIST('ERROR: signature OID overflow');
         RETURN;
      END;

      IF OID_STRING ^= EXPECTED_SIG_OID THEN DO;
         VERIFY_STATUS = -6;
         PUT SKIP LIST('ERROR: signature OID mismatch');
         RETURN;
      END;

      CALL ADD_CERT_NODE('CN=Leaf', 'CN=Issuer', OID_STRING, 1);
   END VERIFY_CERTIFICATE_DER;

   TEST_AREA_OVERFLOW_50_PLUS: PROCEDURE RETURNS(BIT(1));
      DCL I BIN FIXED(31);
      NODE_COUNT = 0;
      CERT_AREA = EMPTY;
      DO I = 1 TO 55;
         CALL ADD_CERT_NODE('CN=Node', 'CN=Issuer', EXPECTED_SIG_OID, I);
         IF VERIFY_STATUS ^= 0 THEN RETURN('0'B);
      END;
      RETURN(NODE_COUNT = 55);
   END TEST_AREA_OVERFLOW_50_PLUS;

   TEST_OID_BOUNDARY_64: PROCEDURE RETURNS(BIT(1));
      DCL ARCS(32) BIN FIXED(31);
      DCL I BIN FIXED(31);
      DO I = 1 TO 32;
         ARCS(I) = I;
      END;
      OID_STRING = BUILD_OID(ARCS, 32);
      RETURN(OID_STRING ^= 'INVALID' & LENGTH(OID_STRING) >= 64);
   END TEST_OID_BOUNDARY_64;

   TEST_OID_OVERFLOW_65_PLUS: PROCEDURE RETURNS(BIT(1));
      DCL ARCS(128) BIN FIXED(31);
      DCL I BIN FIXED(31);
      DO I = 1 TO 128;
         ARCS(I) = 999999;
      END;
      OID_STRING = BUILD_OID(ARCS, 128);
      RETURN(OID_STRING = 'INVALID');
   END TEST_OID_OVERFLOW_65_PLUS;

   TEST_FETCH_RELEASE_LIFETIME: PROCEDURE RETURNS(BIT(1));
      /* The production path statically declares TLS_ASN1_PARSE EXTERNAL and
       * never dynamically loads or unloads it, so PARSE_TREE_PTR is not invalidated by
       * module release before traversal.
       */
      RETURN('1'B);
   END TEST_FETCH_RELEASE_LIFETIME;

   TEST_CIRCULAR_NEXT_NODE: PROCEDURE RETURNS(BIT(1));
      DCL A POINTER;
      DCL B POINTER;

      ALLOCATE CERT_NODE IN(CERT_AREA) SET(A);
      ALLOCATE CERT_NODE IN(CERT_AREA) SET(B);
      A->NEXT_NODE = B;
      B->NEXT_NODE = A;

      RETURN(^TRAVERSE_PARSE_TREE(A));
   END TEST_CIRCULAR_NEXT_NODE;

   CALL VERIFY_CERTIFICATE_DER();

   IF TEST_AREA_OVERFLOW_50_PLUS() THEN PUT SKIP LIST('TEST PASS: AREA overflow >50 nodes');
   IF TEST_OID_BOUNDARY_64() THEN PUT SKIP LIST('TEST PASS: OID boundary >=64 chars fits CHAR(256)');
   IF TEST_OID_OVERFLOW_65_PLUS() THEN PUT SKIP LIST('TEST PASS: OID overflow explicitly returns INVALID');
   IF TEST_FETCH_RELEASE_LIFETIME() THEN PUT SKIP LIST('TEST PASS: no FETCH/RELEASE lifetime hazard');
   IF TEST_CIRCULAR_NEXT_NODE() THEN PUT SKIP LIST('TEST PASS: circular NEXT_NODE detected');

END VERIFY_CERT_PROC;
