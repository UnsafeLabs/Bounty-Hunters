    struct VestingSchedule {
        uint256 totalAllocation;
        uint256 start;
        if (elapsed > schedule.duration) {
            elapsed = schedule.duration;
        }
        // Divide before multiply to prevent intermediate overflow
        uint256 baseVested = schedule.totalAllocation / schedule.duration * elapsed;
        uint256 remainder = schedule.totalAllocation % schedule.duration * elapsed / schedule.duration;
        return baseVested + remainder;
    }

    /**
