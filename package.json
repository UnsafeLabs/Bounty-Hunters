{
  "name": "aigon-pr-bounty-reviewer",
  "version": "1.0.0",
  "description": "A TypeScript CLI application to review open pull requests against acceptance criteria and post constructive feedback with actionable suggestions using LLM integration.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src/**/*.ts",
    "test": "jest --passWithNoTests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aigonmesh/pr-bounty-reviewer.git"
  },
  "keywords": [
    "cli",
    "pull-request-review",
    "github",
    "openai",
    "bounty"
  ],
  "author": "AIGON Enterprise AI",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^20.0.2",
    "openai": "^4.40.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "winston": "^3.12.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.12.12",
    "@types/commander": "^2.12.2",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "@types/jest": "^29.5.12"
  }
}